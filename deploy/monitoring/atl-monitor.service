[Unit]
Description=ATL aggregate capacity snapshot (no load generation)
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/atl-monitor/collect.py
User=root
UMask=0077
CPUQuota=5%
MemoryMax=128M
TasksMax=32
TimeoutStartSec=50
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

