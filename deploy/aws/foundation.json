{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Atl xpres private AWS foundation. Creates billable resources; no DNS changes or live traffic cutover.",
  "Conditions": {
    "HasGitHubProvider": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "GitHubOidcProviderArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Parameters": {
    "GitHubOidcProviderArn": {
      "Type": "String",
      "Default": "",
      "Description": "Existing GitHub OIDC provider ARN; leave blank to omit image publishing role"
    },
    "DatabaseClass": {
      "Type": "String",
      "Default": "db.t4g.small",
      "AllowedValues": [
        "db.t4g.small",
        "db.t4g.medium",
        "db.m7g.large"
      ]
    },
    "CacheClass": {
      "Type": "String",
      "Default": "cache.t4g.small",
      "AllowedValues": [
        "cache.t4g.small",
        "cache.t4g.medium",
        "cache.m7g.large"
      ]
    }
  },
  "Resources": {
    "VPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.90.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "IGW": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "AttachGateway": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "InternetGatewayId": {
          "Ref": "IGW"
        }
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "IGW"
        }
      },
      "DependsOn": "AttachGateway"
    },
    "Public1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.90.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Private1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.90.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Public1"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "EIP1": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "NAT1": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "EIP1",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "Public1"
        }
      },
      "DependsOn": "AttachGateway"
    },
    "PrivateRoutes1": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "PrivateRoute1": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRoutes1"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NAT1"
        }
      }
    },
    "PrivateAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Private1"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes1"
        }
      }
    },
    "Public2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.90.2.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "Private2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        },
        "CidrBlock": "10.90.12.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Public2"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "EIP2": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      }
    },
    "NAT2": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "EIP2",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "Public2"
        }
      },
      "DependsOn": "AttachGateway"
    },
    "PrivateRoutes2": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "PrivateRoute2": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRoutes2"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NAT2"
        }
      }
    },
    "PrivateAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Private2"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutes2"
        }
      }
    },
    "TaskSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private application tasks; ingress added by application stack",
        "VpcId": {
          "Ref": "VPC"
        }
      }
    },
    "DatabaseSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Only application tasks",
        "VpcId": {
          "Ref": "VPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "TaskSG"
            }
          }
        ],
        "SecurityGroupEgress": []
      }
    },
    "RedisSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Only application tasks",
        "VpcId": {
          "Ref": "VPC"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 6379,
            "ToPort": 6379,
            "SourceSecurityGroupId": {
              "Ref": "TaskSG"
            }
          }
        ],
        "SecurityGroupEgress": []
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private two-zone database",
        "SubnetIds": [
          {
            "Ref": "Private1"
          },
          {
            "Ref": "Private2"
          }
        ]
      }
    },
    "DatabaseCredentials": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Database bootstrap credentials; rotate with coordinated runtime update",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"atladmin\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 40,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": {
          "Ref": "DatabaseClass"
        },
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 100,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": true,
        "PubliclyAccessible": false,
        "DBName": "across_db",
        "MasterUsername": "atladmin",
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${DatabaseCredentials}:SecretString:password}}"
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSG"
          }
        ],
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "CopyTagsToSnapshot": true,
        "AutoMinorVersionUpgrade": true
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "RedisPassword": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Generated cache authentication",
        "GenerateSecretString": {
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "RedisSubnets": {
      "Type": "AWS::ElastiCache::SubnetGroup",
      "Properties": {
        "Description": "Private cache",
        "SubnetIds": [
          {
            "Ref": "Private1"
          },
          {
            "Ref": "Private2"
          }
        ]
      }
    },
    "Redis": {
      "Type": "AWS::ElastiCache::ReplicationGroup",
      "Properties": {
        "ReplicationGroupDescription": "Atl xpres shared cache",
        "Engine": "redis",
        "EngineVersion": "7.1",
        "CacheNodeType": {
          "Ref": "CacheClass"
        },
        "NumCacheClusters": 2,
        "AutomaticFailoverEnabled": true,
        "MultiAZEnabled": true,
        "AtRestEncryptionEnabled": true,
        "TransitEncryptionEnabled": true,
        "AuthToken": {
          "Fn::Sub": "{{resolve:secretsmanager:${RedisPassword}:SecretString}}"
        },
        "CacheSubnetGroupName": {
          "Ref": "RedisSubnets"
        },
        "SecurityGroupIds": [
          {
            "Ref": "RedisSG"
          }
        ],
        "SnapshotRetentionLimit": 7
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "Images": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EmptyOnDelete": false
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:3my1234/across-backend-api:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "PushThisRepository",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Images",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      },
      "Condition": "HasGitHubProvider"
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    }
  },
  "Outputs": {
    "VPC": {
      "Value": {
        "Ref": "VPC"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-VPC"
        }
      }
    },
    "Public1": {
      "Value": {
        "Ref": "Public1"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Public1"
        }
      }
    },
    "Public2": {
      "Value": {
        "Ref": "Public2"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Public2"
        }
      }
    },
    "Private1": {
      "Value": {
        "Ref": "Private1"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Private1"
        }
      }
    },
    "Private2": {
      "Value": {
        "Ref": "Private2"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Private2"
        }
      }
    },
    "TaskSG": {
      "Value": {
        "Ref": "TaskSG"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-TaskSG"
        }
      }
    },
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-Cluster"
        }
      }
    },
    "DatabaseHost": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "DatabaseSecretArn": {
      "Value": {
        "Ref": "DatabaseCredentials"
      }
    },
    "RedisHost": {
      "Value": {
        "Fn::GetAtt": [
          "Redis",
          "PrimaryEndPoint.Address"
        ]
      }
    },
    "RedisSecretArn": {
      "Value": {
        "Ref": "RedisPassword"
      }
    },
    "ImageRepository": {
      "Value": {
        "Fn::GetAtt": [
          "Images",
          "RepositoryUri"
        ]
      }
    },
    "BuildRoleArn": {
      "Condition": "HasGitHubProvider",
      "Value": {
        "Fn::GetAtt": [
          "BuildRole",
          "Arn"
        ]
      }
    }
  }
}
