    "ApiService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-Cluster"
          }
        },
        "TaskDefinition": {
          "Ref": "ApiTask"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": {
          "Fn::If": [
            "Enabled",
            2,
            0
          ]
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-Private1"
                }
              },
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-Private2"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-TaskSG"
                }
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 150,
          "MinimumHealthyPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "HealthCheckGracePeriodSeconds": 60,
        "AvailabilityZoneRebalancing": "ENABLED",
        "LoadBalancers": [
          {
            "ContainerName": "app",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      },
      "DependsOn": [
        "Listener",
        "TaskIngress"
      ]
    },
    "WorkerService": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-Cluster"
          }
        },
        "TaskDefinition": {
          "Ref": "WorkerTask"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DesiredCount": {
          "Fn::If": [
            "Enabled",
            1,
            0
          ]
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-Private1"
                }
              },
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-Private2"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-TaskSG"
                }
              }
            ]
          }
        },
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        }
      }
    },
    "ScaleTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": 2,
        "MaxCapacity": {
          "Ref": "MaxApiTasks"
        },
        "ResourceId": {
          "Fn::Join": [
            "",
            [
              "service/",
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "${FoundationStackName}-Cluster"
                }
              },
              "/",
              {
                "Fn::GetAtt": [
                  "ApiService",
                  "Name"
                ]
              }
            ]
          ]
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs",
        "RoleARN": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
        }
      },
      "Condition": "Enabled"
    },
    "CPUScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": "api-cpu-55",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "ScaleTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 55,
          "ScaleOutCooldown": 60,
          "ScaleInCooldown": 300,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      },
      "Condition": "Enabled"
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {}
    },
    "ApiErrors": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "API target 5xx; investigate before increasing replicas",
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_Target_5XX_Count",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "LoadBalancer",
                "LoadBalancerFullName"
              ]
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 2,
        "Threshold": 10,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "Alerts"
          }
        ]
      }
    }
  },
  "Outputs": {
    "LoadBalancerDNS": {
      "Value": {
        "Fn::GetAtt": [
          "LoadBalancer",
          "DNSName"
        ]
      }
    },
    "ApiService": {
      "Value": {
        "Fn::GetAtt": [
          "ApiService",
          "Name"
        ]
      }
    },
    "MigrationTask": {
      "Value": {
        "Ref": "MigrationTask"
      }
    },
    "AlertTopicArn": {
      "Value": {
        "Ref": "Alerts"
      }
    },
    "RuntimeSecretKeys": {
      "Value": "DATABASE_URL,MIGRATION_DATABASE_URL,REDIS_URL,JWT_SECRET,PRIVY_APP_ID,PRIVY_APP_SECRET,PRIVY_VERIFICATION_KEY,FLUTTERWAVE_SECRET_KEY,FLUTTERWAVE_WEBHOOK_SECRET,SMTP_HOST,SMTP_USERNAME,SMTP_PASSWORD,AWS_ACCESS_KEY_ID,AWS_SECRET_ACCESS_KEY,WEB_PUSH_VAPID_PUBLIC_KEY,WEB_PUSH_VAPID_PRIVATE_KEY"
    }
  }
