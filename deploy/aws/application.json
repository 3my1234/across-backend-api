{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Atl xpres pay-as-you-go ALB and private ECS Fargate. Starts paused; no DNS changes.",
  "Parameters": {
    "FoundationStackName": {
      "Type": "String"
    },
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": "[0-9]{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/.+@sha256:[a-f0-9]{64}"
    },
    "RuntimeSecretArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:.+"
    },
    "CertificateArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:acm:[a-z0-9-]+:[0-9]{12}:certificate/.+"
    },
    "MediaBucket": {
      "Type": "String"
    },
    "MediaRegion": {
      "Type": "String",
      "Default": "eu-north-1"
    },
    "EnableService": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ]
    },
    "MaxApiTasks": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 2,
      "MaxValue": 10
    }
  },
  "Conditions": {
    "Enabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableService"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 14
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "RuntimeSecretOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "RuntimeSecretArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "LoadBalancerSG": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "HTTPS ingress",
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-VPC"
          }
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "TaskIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-TaskSG"
          }
        },
        "IpProtocol": "tcp",
        "FromPort": 8080,
        "ToPort": 8080,
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSG"
        }
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": [
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-Public1"
            }
          },
          {
            "Fn::ImportValue": {
              "Fn::Sub": "${FoundationStackName}-Public2"
            }
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSG"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "65"
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Fn::ImportValue": {
            "Fn::Sub": "${FoundationStackName}-VPC"
          }
        },
        "Port": 8080,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/api/v1/ready",
        "HealthCheckIntervalSeconds": 10,
        "HealthCheckTimeoutSeconds": 3,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 2,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "70"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": {
              "Ref": "CertificateArn"
            }
          }
        ],
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "WebACL": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Scope": "REGIONAL",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "CloudWatchMetricsEnabled": true,
          "MetricName": "atl-api-waf",
          "SampledRequestsEnabled": false
        },
        "Rules": [
          {
            "Name": "ManagedCommon",
            "Priority": 0,
            "OverrideAction": {
              "None": {}
            },
            "Statement": {
              "ManagedRuleGroupStatement": {
                "VendorName": "AWS",
                "Name": "AWSManagedRulesCommonRuleSet",
                "RuleActionOverrides": [
                  {
                    "Name": "SizeRestrictions_BODY",
                    "ActionToUse": {
                      "Count": {}
                    }
                  }
                ]
              }
            },
            "VisibilityConfig": {
              "CloudWatchMetricsEnabled": true,
              "MetricName": "atl-common",
              "SampledRequestsEnabled": false
            }
          }
        ]
      }
    },
    "WebACLAssociation": {
      "Type": "AWS::WAFv2::WebACLAssociation",
      "Properties": {
        "ResourceArn": {
          "Ref": "LoadBalancer"
        },
        "WebACLArn": {
          "Fn::GetAtt": [
            "WebACL",
            "Arn"
          ]
        }
      }
    },
    "ApiTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "1024",
        "Memory": "2048",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "StopTimeout": 90,
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "app"
              }
            },
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:DATABASE_URL::"
                }
              },
              {
                "Name": "MIGRATION_DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:MIGRATION_DATABASE_URL::"
                }
              },
              {
                "Name": "REDIS_URL",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:REDIS_URL::"
                }
              },
              {
                "Name": "JWT_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:JWT_SECRET::"
                }
              },
              {
                "Name": "PRIVY_APP_ID",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:PRIVY_APP_ID::"
                }
              },
              {
                "Name": "PRIVY_APP_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:PRIVY_APP_SECRET::"
                }
              },
              {
                "Name": "PRIVY_VERIFICATION_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:PRIVY_VERIFICATION_KEY::"
                }
              },
              {
                "Name": "FLUTTERWAVE_SECRET_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:FLUTTERWAVE_SECRET_KEY::"
                }
              },
              {
                "Name": "FLUTTERWAVE_WEBHOOK_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:FLUTTERWAVE_WEBHOOK_SECRET::"
                }
              },
              {
                "Name": "SMTP_HOST",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:SMTP_HOST::"
                }
              },
              {
                "Name": "SMTP_USERNAME",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:SMTP_USERNAME::"
                }
              },
              {
                "Name": "SMTP_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:SMTP_PASSWORD::"
                }
              },
              {
                "Name": "AWS_ACCESS_KEY_ID",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:AWS_ACCESS_KEY_ID::"
                }
              },
              {
                "Name": "AWS_SECRET_ACCESS_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:AWS_SECRET_ACCESS_KEY::"
                }
              },
              {
                "Name": "WEB_PUSH_VAPID_PUBLIC_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:WEB_PUSH_VAPID_PUBLIC_KEY::"
                }
              },
              {
                "Name": "WEB_PUSH_VAPID_PRIVATE_KEY",
                "ValueFrom": {
                  "Fn::Sub": "${RuntimeSecretArn}:WEB_PUSH_VAPID_PRIVATE_KEY::"
                }
              }
            ],
            "Environment": [
              {
                "Name": "APP_ENV",
                "Value": "production"
              },
              {
                "Name": "HTTP_ADDR",
                "Value": ":8080"
              },
              {
                "Name": "RUN_MIGRATIONS",
                "Value": "false"
              },
              {
                "Name": "RUN_INLINE_WORKERS",
                "Value": "false"
              },
              {
                "Name": "REDIS_OPTIONAL",
                "Value": "false"
              },
              {
                "Name": "DB_MAX_CONNS",
                "Value": "4"
              },
              {
                "Name": "DB_MIN_CONNS",
                "Value": "1"
              },
              {
                "Name": "HTTP_MAX_IN_FLIGHT",
                "Value": "64"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "MediaRegion"
                }
              },
              {
                "Name": "S3_BUCKET_NAME",
                "Value": {
                  "Ref": "MediaBucket"
                }
              },
              {
                "Name": "SMTP_PORT",
                "Value": "587"
              },
              {
                "Name": "SMTP_FROM_EMAIL",
                "Value": "welcome@atlxpres.com"
              },
              {
                "Name": "ALLOWED_ORIGINS",
                "Value": "https://atlxpres.com,https://admin.atlxpres.com,https://provider.atlxpres.com"
              }
            ],
            "Name": "app",
            "Command": [
              "/app/across-api"
            ],
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "curl -fsS --max-time 3 http://localhost:8080/api/v1/health || exit 1"
              ],
              "Interval": 15,
              "Timeout": 4,
              "Retries": 3,
              "StartPeriod": 30
            }
          }
        ]
      }
    },
    "WorkerTask": {
