# Shared by the API and worker resources. Store real values only in Coolify.
APP_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@PRIMARY_HOST:5432/across_db?sslmode=verify-full
# Optional read replica. Leave blank until your PostgreSQL provider supplies one.
DATABASE_READ_URL=
# Direct primary PostgreSQL URL, bypassing PgBouncer transaction pooling.
MIGRATION_DATABASE_URL=postgres://USER:PASSWORD@PRIMARY_HOST:5432/across_db?sslmode=verify-full
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379/0
REDIS_OPTIONAL=false
# For a private CA, mount it read-only and configure REDIS_TLS_CA_FILE.
REDIS_TLS_CA_FILE=
# Replace with verified ingress addresses; never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
HTTP_MAX_IN_FLIGHT=64
ENABLE_DEV_LOGIN=false
ENABLE_MOCK_PAYMENTS=false

# Per-resource connection budgets. Keep the sum across every replica below the
# PostgreSQL limit, including every worker, optional read pool and migration.
# API candidate: 8 per replica. Worker resources need their own explicit limits.
# Validate the complete budget using scripts/launch_budget.py before deployment.
DB_MAX_CONNS=8
DB_MIN_CONNS=0
DB_READ_MAX_CONNS=8
DB_READ_MIN_CONNS=0
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=4

# API resource: workers are deployed separately.
RUN_INLINE_WORKERS=false
RUN_MIGRATIONS=false
WORKER_HEALTH_ADDR=:8080
RATE_LIMIT_PER_MINUTE=600
PUBLIC_CACHE_TTL_SECONDS=5

# Permanent Free tier remains available. Paid listing/media/room benefits are
# resolved from verified active subscriptions; this legacy switch does not grant them.
PROVIDER_SUBSCRIPTIONS_ENFORCED=false
PROVIDER_SUBSCRIPTIONS_START_AT=

HTTP_ADDR=:8080
ALLOWED_ORIGINS=https://atlxpres.com,https://www.atlxpres.com,https://admin.atlxpres.com
PUBLIC_BASE_URL=https://api.atlxpres.com
WEBSITE_URL=https://atlxpres.com
PROVIDER_PORTAL_URL=https://admin.atlxpres.com/provider.html
ASSETS_CDN_BASE=https://media.atlxpres.com

# Existing production secrets/configuration are also required:
# JWT_SECRET, PRIVY_APP_ID, PRIVY_APP_SECRET,
# FLUTTERWAVE_SECRET_KEY, FLUTTERWAVE_WEBHOOK_SECRET,
# AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET_NAME,
# SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD,
# SMTP_FROM_EMAIL, SMTP_FROM_NAME, SMTP_REPLY_TO, SES_SNS_TOPIC_ARN.

# Leave disabled until migration110, the message_fanout worker, backlog alerts,
# notification drain/reconciliation and a controlled rollout have been verified.
ASYNC_MESSAGE_NOTIFICATIONS=false

# Opt-in only after migration112, dedicated capped media worker, source/output
# verification, S3 permissions/temporary lifecycle and client compatibility review.
# This does not add encoding to ordinary all-role workers or API processes.
ASYNC_VIDEO_PROCESSING=false
ASYNC_IMAGE_PROCESSING=false
