# Shared by the API and worker resources. Store real values only in Coolify.
APP_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@PRIMARY_HOST:5432/across_db?sslmode=require
# Optional read replica. Leave blank until your PostgreSQL provider supplies one.
DATABASE_READ_URL=
# Direct primary PostgreSQL URL, bypassing PgBouncer transaction pooling.
MIGRATION_DATABASE_URL=postgres://USER:PASSWORD@PRIMARY_HOST:5432/across_db?sslmode=require
REDIS_URL=redis://:PASSWORD@REDIS_HOST:6379/0
REDIS_OPTIONAL=false

# Per-resource connection budgets. Keep the sum across every replica below the
# managed PostgreSQL/PgBouncer limit.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_READ_MAX_CONNS=20
DB_READ_MIN_CONNS=2
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=4

# API resource: workers are deployed separately.
RUN_INLINE_WORKERS=false
RUN_MIGRATIONS=false
WORKER_HEALTH_ADDR=:8080
RATE_LIMIT_PER_MINUTE=600
PUBLIC_CACHE_TTL_SECONDS=5

# Free launch. Set true to require paid plans immediately, or set a UTC start
# instant to enable paid plans later without another deploy.
PROVIDER_SUBSCRIPTIONS_ENFORCED=false
PROVIDER_SUBSCRIPTIONS_START_AT=

HTTP_ADDR=:8080
ALLOWED_ORIGINS=https://atlxpres.com,https://www.atlxpres.com,https://admin.atlxpres.com
PUBLIC_BASE_URL=https://api.atlxpres.com
WEBSITE_URL=https://atlxpres.com
PROVIDER_PORTAL_URL=https://admin.atlxpres.com/provider.html
ASSETS_CDN_BASE=https://media.atlxpres.com

# Existing production secrets/configuration are also required:
# JWT_SECRET, PRIVY_APP_ID, PRIVY_APP_SECRET,
# FLUTTERWAVE_SECRET_KEY, FLUTTERWAVE_WEBHOOK_SECRET,
# AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, S3_BUCKET_NAME,
# SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD,
# SMTP_FROM_EMAIL, SMTP_FROM_NAME, SMTP_REPLY_TO, SES_SNS_TOPIC_ARN.
