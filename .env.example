APP_ENV=development
HTTP_ADDR=:8080
ALLOWED_ORIGINS=https://atlxpres.com,https://admin.atlxpres.com,https://provider.atlxpres.com
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-database-password
DB_NAME=across_db
# DATABASE_URL=postgres://postgres:replace-with-password@localhost:5432/across_db?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_OPTIONAL=true
JWT_SECRET=replace-with-long-random-secret
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx
# Mock charges are disabled by default. Enable only for isolated local development.
ENABLE_MOCK_PAYMENTS=false
FLUTTERWAVE_WEBHOOK_SECRET=replace-with-webhook-secret
# Must match Dashboard > Settings > Business preference > Fee Settings.
FLUTTERWAVE_CUSTOMER_PAYS_FEES=false
PRIVY_APP_ID=cmr5111vg019p0cjoai93u7e3
PRIVY_APP_SECRET=replace-with-privy-app-secret
# Optional fallback; fetched automatically when PRIVY_APP_SECRET is configured
PRIVY_VERIFICATION_KEY=
DEFAULT_COUNTRY=NG
ALLOWED_COUNTRIES=NG
PROVIDER_SUBSCRIPTIONS_ENFORCED=false
# Optional UTC instant when paid provider subscriptions begin, e.g. 2027-01-01T00:00:00Z.
PROVIDER_SUBSCRIPTIONS_START_AT=

# Amazon SES SMTP (transactional and support emails)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-ses-username
SMTP_PASSWORD=replace-with-ses-password
# SMTP_USER and SMTP_PASS are accepted aliases for the two variables above.
SMTP_FROM_EMAIL=welcome@atlxpres.com
# DEFAULT_FROM_EMAIL is an accepted alias for SMTP_FROM_EMAIL.
SMTP_FROM_NAME=Atlantic Express
# DEFAULT_FROM_NAME is an accepted alias for SMTP_FROM_NAME.
SMTP_REPLY_TO=support@atlxpres.com
SES_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:atlantic-express-ses-events
ASSETS_CDN_BASE=https://media.atlxpres.com
BRAND_LOGO_URL=https://api.atlxpres.com/api/v1/public/brand/logo.png?v=20260929-atl
WEBSITE_URL=https://atlxpres.com
PUBLIC_BASE_URL=https://api.atlxpres.com
PROVIDER_PORTAL_URL=https://provider.atlxpres.com
