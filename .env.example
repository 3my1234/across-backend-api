# DEFAULT_FROM_EMAIL is an accepted alias for SMTP_FROM_EMAIL.
SMTP_FROM_NAME=Atlantic Express Support
# DEFAULT_FROM_NAME is an accepted alias for SMTP_FROM_NAME.
